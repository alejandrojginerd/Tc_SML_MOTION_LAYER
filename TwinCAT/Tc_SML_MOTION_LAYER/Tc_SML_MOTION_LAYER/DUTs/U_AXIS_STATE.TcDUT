<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="U_AXIS_STATE" Id="{27cbe5d1-5d22-51e6-bdf0-119baf9c66b9}">
    <Declaration><![CDATA[(* ============================================================
   U_AXIS_STATE - Bus UNION for the axis state
   SML v8 - Level B / MAPPING (new)

   stData : ST_AXIS_STATE (typed) / aRaw : byte block (fieldbus).
   Fixed size = MAP_SIZE_STATE (>= SIZEOF(ST_AXIS_STATE)).
   ============================================================ *)

TYPE U_AXIS_STATE :
UNION
    stData : ST_AXIS_STATE;
    aRaw   : ARRAY[1..GVL_SML_CONST.MAP_SIZE_STATE] OF BYTE;
END_UNION
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
